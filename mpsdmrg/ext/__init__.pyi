"""Type stubs of the C++ symmetry engine (``symmetry_ext``).

The engine is a pybind11 extension, so this file is the only description of its Python API.
It mirrors what ``mpsdmrg/ext/__init__.py`` re-exports.
"""
from __future__ import annotations

from enum import Enum
from typing import Any, Callable, Sequence

import torch

Sector = tuple[int, ...]

class FusionStyle(Enum):
    single = 0
    multiple_unique = 10
    general = 20

class BraidingStyle(Enum):
    bosonic = 0
    fermionic = 10

class Group:
    """Charge fusion data: sector duality, fusion outcomes and dimensions."""
    fusion_style: FusionStyle
    braiding_style: BraidingStyle
    trivial_sector: Sector
    group_name: str
    type_name: str
    num_sectors: int | float
    sector_ind_len: int
    is_abelian: bool
    def is_valid_sector(self, sector: Sector) -> bool: ...
    def dual_sector(self, sector: Sector) -> Sector: ...
    def fusion_outcomes(self, first: Sector, second: Sector) -> tuple[Sector, ...]: ...
    def sector_dim(self, sector: Sector) -> int: ...
    def fuse(self, *sectors: Sector) -> Sector: ...
    def can_fuse_to(self, first: Sector, second: Sector, coupled: Sector) -> bool: ...
    def n_symbol(self, first: Sector, second: Sector, coupled: Sector) -> int: ...
    def fusion_tensor(self, first: Sector, second: Sector, coupled: Sector,
                      device: torch.device) -> torch.Tensor: ...
    def all_sectors(self) -> tuple[Sector, ...]: ...
    def sector_of_dimension(self, dim: int) -> Sector: ...
    def duality_matrix(self, sector: Sector, device: torch.device) -> torch.Tensor: ...
    def invariant_form(self, sector: Sector, device: torch.device) -> torch.Tensor: ...
    def is_same_symmetry(self, other: Group) -> bool: ...

class AbelianGroup(Group):
    """A group whose fusion has a single outcome."""
    sector_dim: Any

class NoSymmetry(Group): ...
class U1Symmetry(Group): ...
class ZNSymmetry(Group):
    def __init__(self, N: int) -> None: ...
    @property
    def N(self) -> int: ...
class SU2Symmetry(Group): ...
class SU3Symmetry(Group): ...
class FermionParity(Group): ...

class Leg:
    """One leg of a tensor: a group, the sectors of its blocks and their boundaries."""
    def __init__(self, group: Group, sectors: Sequence[Sector], slices: Sequence[int],
                 qconj: int = 1) -> None: ...
    @staticmethod
    def trivial(dim: int, group: Group | None = None, qconj: int = 1) -> Leg: ...
    @staticmethod
    def from_blocks(group: Group, entries: Sequence[tuple[Sector, int]],
                    qconj: int = 1) -> tuple[Leg, tuple[int, ...]]: ...
    group: Group
    sectors: tuple[Sector, ...]
    slices: tuple[int, ...]
    qconj: int
    dim: int
    nblocks: int
    def sector(self, qi: int, dual: bool = False) -> Sector: ...
    def block_dim(self, qi: int) -> int: ...
    def multiplicity(self, qi: int) -> int: ...
    def fuse(self, other: Leg) -> Leg: ...
    def conj(self) -> Leg: ...

class FusionTree:
    """The fusion of one block: its leg sectors, the intermediate couplings and the total."""
    def __init__(self, group: Group, sectors: Sequence[Sector], inner: Sequence[Sector],
                 coupled: Sector) -> None: ...
    @staticmethod
    def from_blocks(group: Group, legs: Sequence[Leg], qdata: Sequence[int | Sector],
                    qtotal: Sector) -> FusionTree: ...
    group: Group
    sectors: tuple[Sector, ...]
    inner: tuple[Sector, ...]
    coupled: Sector
    chain: tuple[Sector, ...]
    def to_dense_block(self, device: torch.device) -> torch.Tensor: ...

class Tensor:
    """A block-sparse tensor: one dense block per charge key, all legs carrying a group."""
    def __init__(self, blocks: Sequence[torch.Tensor], qdata: Sequence[Sequence[int | Sector]],
                 legs: Sequence[Leg], qtotal: Sector | None = None,
                 group: Group | None = None) -> None: ...
    @staticmethod
    def from_torch(data: torch.Tensor, legs: Sequence[Leg] | None = None,
                   qtotal: Sector | None = None) -> Tensor: ...
    @staticmethod
    def rand(*shape: int | Sequence[int], dtype: torch.dtype | None = None,
             device: torch.device | None = None,
             legs: Sequence[Leg] | None = None, group: Group | None = None,
             qtotal: Sector | None = None) -> Tensor: ...
    @staticmethod
    def ones(*shape: int | Sequence[int], dtype: torch.dtype | None = None,
             device: torch.device | None = None,
             legs: Sequence[Leg] | None = None, group: Group | None = None,
             qtotal: Sector | None = None) -> Tensor: ...
    @staticmethod
    def zeros(*shape: int | Sequence[int], dtype: torch.dtype | None = None,
              device: torch.device | None = None,
              legs: Sequence[Leg] | None = None, group: Group | None = None,
              qtotal: Sector | None = None) -> Tensor: ...
    blocks: list[torch.Tensor]
    qdata: tuple[tuple[int | Sector, ...], ...]
    legs: tuple[Leg, ...]
    qtotal: Sector
    group: Group
    shape: tuple[int, ...]
    dtype: torch.dtype
    device: torch.device
    is_dense: bool
    real: Tensor
    def numel(self) -> int: ...
    def element_size(self) -> int: ...
    def to_torch(self) -> torch.Tensor: ...
    def item(self) -> complex: ...
    def clone(self) -> Tensor: ...
    def detach(self) -> Tensor: ...
    def conj(self) -> Tensor: ...
    def to(self, device: torch.device | None = None,
           dtype: torch.dtype | None = None) -> Tensor: ...
    def combine_legs(self, groups: Sequence[Sequence[int]]) -> Tensor: ...
    def __getitem__(self, key: Any) -> Tensor: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def __add__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __radd__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __sub__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __mul__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __rmul__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __truediv__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __iadd__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __imul__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __itruediv__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...

def cached_einsum(equation: str, *tensors: Tensor | torch.Tensor) -> Tensor: ...
_expr_cache: Any
def svd(t: Tensor, left: Sequence[int], right: Sequence[int], max_bond: int | None = None,
        tol: float = 0.0, direction: str = 'right'
        ) -> tuple[Tensor, torch.Tensor, Tensor]: ...
def qr(t: Tensor, left: Sequence[int], right: Sequence[int]) -> tuple[Tensor, Tensor]: ...
def rq(t: Tensor, left: Sequence[int], right: Sequence[int]) -> tuple[Tensor, Tensor]: ...
def svdvals(t: Tensor, left: Sequence[int], right: Sequence[int]) -> torch.Tensor: ...
def norm(t: Tensor, dim: Sequence[int] | None = None) -> torch.Tensor: ...
def inner(a: Tensor, b: Tensor) -> torch.Tensor: ...
def trace(t: Tensor) -> torch.Tensor: ...
def fusion_trees(group: Group, sectors: Sequence[Sector],
                 coupled: Sector) -> tuple[FusionTree, ...]: ...
def stored_dense(legs: Sequence[Leg], tree: FusionTree, device: torch.device) -> torch.Tensor: ...
def dual_sign(group: Group, sector: Sector) -> float: ...
def fusion_tensor(j1: int, j2: int, j3: int, device: torch.device) -> torch.Tensor: ...
def fusion_table(j1: int, j2: int, device: torch.device) -> dict[int, torch.Tensor]: ...
def recoupling(j1: int, j2: int, j3: int, j4: int
                ) -> tuple[tuple[int, ...], tuple[int, ...], torch.Tensor]: ...
def set_defaults(device: str, dtype: str) -> None: ...
def clear_caches() -> None: ...

no_symmetry: NoSymmetry
u1_symmetry: U1Symmetry
su2_symmetry: SU2Symmetry
su3_symmetry: SU3Symmetry
su3_clebsch_copies: Callable[[Sector, Sector, Sector, torch.device], torch.Tensor]
fermion_parity: FermionParity
z2_symmetry: ZNSymmetry
z3_symmetry: ZNSymmetry
z4_symmetry: ZNSymmetry
z5_symmetry: ZNSymmetry
z6_symmetry: ZNSymmetry
z7_symmetry: ZNSymmetry
z8_symmetry: ZNSymmetry
z9_symmetry: ZNSymmetry
