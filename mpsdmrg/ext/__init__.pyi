from __future__ import annotations

from enum import Enum
from typing import Any, Sequence

import torch

Sector = tuple[int, ...]

class FusionStyle(Enum):
    single = 0
    multiple_unique = 10
    general = 20

class BraidingStyle(Enum):
    bosonic = 0
    fermionic = 10

class FusionCategory:
    """The categorical data of a symmetry: its labels, their fusion, and the associator and
    braiding that recouple them."""
    fusion_style: FusionStyle
    braiding_style: BraidingStyle
    trivial_sector: Sector
    name: str
    type_name: str
    is_abelian: bool
    is_trivial: bool
    def dual_sector(self, sector: Sector) -> Sector: ...
    def fusion_outcomes(self, first: Sector, second: Sector) -> tuple[Sector, ...]: ...
    def fusion_channels(self, first: Sector, second: Sector) -> tuple[tuple[Sector, int], ...]: ...
    def sector_dim(self, sector: Sector) -> int: ...
    def quantum_dim(self, sector: Sector) -> float: ...
    def fuse(self, *sectors: Sector) -> Sector: ...
    def fusion_tensor(self, first: Sector, second: Sector, coupled: Sector,
                      device: torch.device, copy: int = 0) -> torch.Tensor: ...
    def associator(self, first: Sector, second: Sector, third: Sector, coupled: Sector,
                   left: Sector, right: Sector, device: torch.device) -> torch.Tensor: ...
    def braiding(self, first: Sector, second: Sector, coupled: Sector,
                 device: torch.device) -> torch.Tensor: ...
    def dual_sign(self, sector: Sector) -> float: ...
    def dual_phase(self, sector: Sector) -> float: ...
    def clear_caches(self) -> None: ...

class Group(FusionCategory):
    """A group: a category whose associator and braiding come from its Clebsch-Gordan calculus."""
    def invariant_form(self, sector: Sector, device: torch.device) -> torch.Tensor: ...

class FibonacciCategory(FusionCategory):
    """The Fibonacci fusion category: the objects 1 and tau with tau (x) tau = 1 + tau."""

class ZNSymmetry(Group):
    """The cyclic group Z_N; the singletons z2..z9 cover the common moduli."""
    def __init__(self, N: int) -> None: ...

def site_leg(group: Group, dim: int, qconj: int = 1) -> Any: ...
def multiplet_leg(group: Group, sector: Sector, qconj: int = 1) -> Any: ...
def bond_leg(group: Group, entries: Sequence[tuple[Sector, int]],
             qconj: int = 1) -> Any: ...
def fuse_legs(first: Any, second: Any) -> Any: ...
def capped_leg(leg: Any, max_multiplets: int) -> Any: ...


class Tensor:
    """A block-sparse tensor: one dense block per charge key, all legs carrying a group."""
    def __init__(self, blocks: Sequence[torch.Tensor], qdata: Sequence[Sequence[int | Sector]],
                 legs: Sequence[Any], qtotal: Sector | None = None,
                 group: Group | None = None) -> None: ...
    @staticmethod
    def from_torch(data: torch.Tensor, legs: Sequence[Any] | None = None,
                   qtotal: Sector | None = None) -> Tensor: ...
    @staticmethod
    def rand(*shape: int | Sequence[int], dtype: torch.dtype | None = None,
             device: torch.device | None = None,
             legs: Sequence[Any] | None = None, group: Group | None = None,
             qtotal: Sector | None = None) -> Tensor: ...
    @staticmethod
    def ones(*shape: int | Sequence[int], dtype: torch.dtype | None = None,
             device: torch.device | None = None,
             legs: Sequence[Any] | None = None, group: Group | None = None,
             qtotal: Sector | None = None) -> Tensor: ...
    @staticmethod
    def zeros(*shape: int | Sequence[int], dtype: torch.dtype | None = None,
              device: torch.device | None = None,
              legs: Sequence[Any] | None = None, group: Group | None = None,
              qtotal: Sector | None = None) -> Tensor: ...
    blocks: list[torch.Tensor]
    qdata: tuple[tuple[int | Sector, ...], ...]
    legs: tuple[Any, ...]
    qtotal: Sector
    group: Group
    shape: tuple[int, ...]
    dtype: torch.dtype
    device: torch.device
    is_dense: bool
    real: Tensor
    def numel(self) -> int: ...
    def element_size(self) -> int: ...
    @property
    def homogeneous(self) -> bool: ...
    def item(self) -> complex: ...
    def clone(self) -> Tensor: ...
    def detach(self) -> Tensor: ...
    def conj(self) -> Tensor: ...
    def to(self, device: torch.device | None = None,
           dtype: torch.dtype | None = None) -> Tensor: ...
    def combine_legs(self, groups: Sequence[Sequence[int]]) -> Tensor: ...
    def __getitem__(self, key: Any) -> Tensor: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def __add__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __radd__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __sub__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __mul__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __rmul__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __truediv__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __iadd__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __imul__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...
    def __itruediv__(self, other: Tensor | torch.Tensor | complex) -> Tensor: ...

def cached_einsum(equation: str, *tensors: Tensor | torch.Tensor) -> Tensor: ...
def svd(t: Tensor, left: Sequence[int], right: Sequence[int], max_bond: int | None = None,
        tol: float = 0.0, direction: str = 'right'
        ) -> tuple[Tensor, torch.Tensor, Tensor]: ...
def qr(t: Tensor, left: Sequence[int], right: Sequence[int]) -> tuple[Tensor, Tensor]: ...
def rq(t: Tensor, left: Sequence[int], right: Sequence[int]) -> tuple[Tensor, Tensor]: ...
def svdvals(t: Tensor, left: Sequence[int], right: Sequence[int]) -> torch.Tensor: ...
def norm(t: Tensor, dim: Sequence[int] | None = None) -> torch.Tensor: ...
def inner(a: Tensor, b: Tensor) -> torch.Tensor: ...
def trace(t: Tensor) -> torch.Tensor: ...
def clear_caches() -> None: ...

# the raw extension: the engine's internal names, for the engine layers and the contract checks
_engine: Any
_expr_cache: Any

no_symmetry: Group
u1_symmetry: Group
su2_symmetry: Group
su3_symmetry: Group
fermion_parity: Group
z2_symmetry: ZNSymmetry
fibonacci: FibonacciCategory
